---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = [
  {
    type: '知识管理',
    name: 'Obsidian Vault',
    desc: '个人知识库工作流,结合 Obsidian + AI Agent 实现从采集到沉淀的自动化。',
    tags: ['Obsidian', 'Python', 'AI'],
  },
  {
    type: '方法论',
    name: 'Vibe Coding 研究',
    desc: '精读 Vibe Coding 教程,提炼可迁移方法论,涵盖意图驱动、产品变现与 GEO。',
    tags: ['AI', 'Prompt Engineering', 'GEO'],
  },
  {
    type: '架构',
    name: '记忆系统',
    desc: '分层记忆、生命周期与长期沉淀的边界设计,降低重复解释成本。',
    tags: ['Hermes', 'Memory', '架构'],
  },
  {
    type: '设计研究',
    name: 'Lusion 风格研究',
    desc: '研究高端品牌站如何通过光效、空间层次和动效节奏建立高级感。',
    tags: ['3D', '排版', '动效'],
  },
  {
    type: '工作流',
    name: '自动化工作流',
    desc: '把采集、整理、输出和监控拆成稳定模块,避免一次性脚本无法维护。',
    tags: ['Playwright', 'RSS', '监控'],
  },
  {
    type: '基础设施',
    name: '自托管监控',
    desc: 'Uptime Kuma + Healthchecks 的本地服务监控与告警方案。',
    tags: ['Docker', '自托管'],
  },
];

// 索引页去重描述
const allProjects = projects.map(p => ({...p, id: p.name}));
---

<Base title="项目" description="已完成的学习项目与实践记录">
  <section class="page">
    <h1 class="page-title">项目</h1>
    <p class="page-subtitle">做过的东西,保持可回顾、可继续迭代。共 {projects.length} 个。</p>
    <div class="project-grid">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
  </section>
</Base>

---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";

const notes = (await getCollection("notes")).sort(
	(a, b) => b.data.published.getTime() - a.data.published.getTime(),
);
---

<MainGridLayout title="说说" description="短想法、零碎记录与正在发生的事。">
	<div class="notes-page">
		<header class="notes-hero">
			<p class="notes-hero__eyebrow">NOW / SHORT NOTES</p>
			<h1>说说</h1>
			<p>不成篇的想法、正在做的事、踩过的坑。比文章短，比推文长。</p>
			<div class="notes-hero__stats">
				<span><strong>{notes.length}</strong> 条记录</span>
			</div>
		</header>

		{notes.length === 0 ? (
			<p class="notes-empty">还没有说说。</p>
		) : (
			<ol class="notes-timeline">
				{notes.map((note) => (
					<li class="notes-item">
						<span class="notes-item__dot" aria-hidden="true"></span>
						<div class="notes-item__body">
							<time class="notes-item__date" datetime={note.data.published.toISOString()}>
								{formatDateToYYYYMMDD(note.data.published)}
							</time>
							<div class="notes-item__content">
								<note.render />
							</div>
							{note.data.tags.length > 0 && (
								<div class="notes-item__tags">
									{note.data.tags.map((tag) => (
										<span class="notes-item__tag">{tag}</span>
									))}
								</div>
							)}
						</div>
					</li>
				))}
			</ol>
		)}
	</div>
</MainGridLayout>

<style>
	.notes-page { display: grid; gap: 1.4rem; }

	.notes-hero {
		padding: 1.15rem 1.25rem 1.25rem;
		border: 1px solid color-mix(in oklch, var(--primary) 24%, var(--card-border, #dce5e5));
		border-radius: var(--radius-large);
		background: linear-gradient(
			135deg,
			color-mix(in oklch, var(--primary) 10%, var(--card-bg, #fff)),
			color-mix(in oklch, var(--card-bg, #fff) 86%, transparent)
		);
		box-shadow: 0 20px 45px -34px color-mix(in oklch, var(--primary) 48%, transparent);
	}
	.notes-hero__eyebrow {
		margin: 0;
		color: var(--primary);
		font-family: var(--font-mono, monospace);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
	}
	.notes-hero h1 { margin: 0.55rem 0 0; font-size: clamp(1.7rem, 4vw, 2.45rem); line-height: 1.1; }
	.notes-hero > p:not(.notes-hero__eyebrow) {
		max-width: 42rem;
		margin: 0.75rem 0 0;
		color: var(--text-70, #475569);
		font-size: 0.82rem;
		line-height: 1.8;
	}
	.notes-hero__stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1rem;
		margin-top: 1rem;
		color: var(--text-50, #64748b);
		font-family: var(--font-mono, monospace);
		font-size: 0.65rem;
	}
	.notes-hero__stats strong { color: var(--primary); font-size: 0.9rem; }

	.notes-empty {
		padding: 3rem 1rem;
		border: 1px dashed var(--card-border, #dce5e5);
		border-radius: var(--radius-large);
		color: var(--text-50, #64748b);
		text-align: center;
	}

	/* 时间轴：左侧一条主色渐变竖线，每条一个发光圆点 */
	.notes-timeline {
		position: relative;
		display: grid;
		gap: 1.1rem;
		margin: 0;
		padding: 0 0 0 1.6rem;
		list-style: none;
	}
	.notes-timeline::before {
		position: absolute;
		top: 0.4rem;
		bottom: 0.4rem;
		left: 0.34rem;
		width: 2px;
		border-radius: 999px;
		background: linear-gradient(
			180deg,
			color-mix(in oklch, var(--primary) 70%, transparent),
			color-mix(in oklch, var(--primary) 12%, transparent)
		);
		content: "";
	}

	.notes-item { position: relative; }
	.notes-item__dot {
		position: absolute;
		top: 0.85rem;
		left: -1.6rem;
		width: 0.6rem;
		height: 0.6rem;
		margin-left: 0.06rem;
		border: 2px solid var(--card-bg, #fff);
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 18%, transparent);
	}

	.notes-item__body {
		padding: 0.9rem 1.05rem 1rem;
		border: 1px solid var(--card-border, #dce5e5);
		border-radius: var(--radius-large);
		background: color-mix(in oklch, var(--card-bg, #fff) 92%, transparent);
		transition: border-color 0.35s var(--ease-tech, cubic-bezier(0.16, 1, 0.3, 1)),
			box-shadow 0.35s var(--ease-tech, cubic-bezier(0.16, 1, 0.3, 1));
	}
	.notes-item__body:hover {
		border-color: color-mix(in oklch, var(--primary) 30%, var(--card-border, #dce5e5));
		box-shadow: 0 14px 34px -26px color-mix(in oklch, var(--primary) 55%, transparent);
	}

	.notes-item__date {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--primary);
		font-family: var(--font-mono, monospace);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
	}

	.notes-item__content { color: var(--text-75, #334155); font-size: 0.86rem; line-height: 1.85; }
	.notes-item__content :global(p) { margin: 0 0 0.6rem; }
	.notes-item__content :global(p:last-child) { margin-bottom: 0; }
	.notes-item__content :global(a) { color: var(--primary); text-decoration: underline; text-underline-offset: 2px; }
	.notes-item__content :global(code) {
		padding: 0.1rem 0.35rem;
		border-radius: 0.3rem;
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		font-family: var(--font-mono, monospace);
		font-size: 0.82em;
	}

	.notes-item__tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.7rem; }
	.notes-item__tag {
		padding: 0.1rem 0.5rem;
		border: 1px solid color-mix(in oklch, var(--primary) 26%, transparent);
		border-radius: 999px;
		color: var(--primary);
		font-size: 0.62rem;
	}

	:global(.dark) .notes-hero {
		background: linear-gradient(
			135deg,
			color-mix(in oklch, var(--primary) 13%, var(--card-bg, #172033)),
			color-mix(in oklch, var(--card-bg, #172033) 88%, transparent)
		);
	}
	:global(.dark) .notes-item__body { background: color-mix(in oklch, var(--card-bg, #172033) 82%, transparent); }
	:global(.dark) .notes-item__content { color: var(--text-75, #cbd5e1); }

	@media (max-width: 640px) {
		.notes-timeline { padding-left: 1.25rem; }
		.notes-item__dot { left: -1.25rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.notes-item__body { transition: none; }
	}
</style>

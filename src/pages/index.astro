---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 5);
const featuredPosts = sortedPosts.filter((p) => p.data.featured).slice(0, 3);

// 精选项目(从原 archive 迁移 + 新增)
const projects = [
  {
    type: '知识管理',
    name: 'Obsidian Vault',
    desc: '个人知识库与内容创作工作流,结合 Obsidian + Hermes Agent 实现全链路自动化。',
    tags: ['Obsidian', 'Python', 'AI'],
    href: 'https://github.com/Hongmingbo/obsidian-vault',
  },
  {
    type: '方法论',
    name: 'Vibe Coding 研究',
    desc: '精读 14 个 Vibe Coding 教程,提炼 38 条可迁移方法论,涵盖意图驱动、产品变现与 GEO。',
    tags: ['AI', 'Prompt Engineering', 'GEO'],
  },
  {
    type: '基础设施',
    name: 'Cloudflare 邮件服务',
    desc: '基于 Cloudflare Workers 的自托管邮箱系统,D1 + KV + R2 全 Serverless 架构。',
    tags: ['Cloudflare', 'Workers', 'D1'],
    href: 'https://github.com/Hongmingbo/cloud-mail',
  },
  {
    type: '设计研究',
    name: 'Lusion 风格研究',
    desc: '研究高端品牌站如何通过光效、空间层次、动效节奏和中文排版建立高级感。',
    tags: ['3D', '氛围', '排版'],
  },
];
---

<Base title="首页">
  <section class="hero reveal">
    <h1 class="hero-greeting">你好 <span class="wave">👋</span></h1>
    <p class="hero-intro">
      我是 <strong>Hmingbo</strong>,一名专注 <strong>AI Agent、前端工程与知识管理</strong> 的开发者。
      在这里记录技术实践、方法论研究,以及自托管基础设施的踩坑与心得。
    </p>
    <div class="hero-socials">
      <a href="https://github.com/Hongmingbo" class="social-link" aria-label="GitHub" target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="/rss.xml" class="social-link" aria-label="RSS" target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 17.82a1.82 1.82 0 1 1-3.64 0 1.82 1.82 0 0 1 3.64 0zm-.73-6.73a10.91 10.91 0 0 1 10.91 10.91h2.55a13.45 13.45 0 0 0-13.46-13.45v2.54zM5.45 4.36A17.27 17.27 0 0 1 22.73 21.6h2.54a19.82 19.82 0 0 0-19.82-19.82v2.58z"/></svg>
      </a>
      <a href="mailto:hongmingbo2011@gmail.com" class="social-link" aria-label="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
    </div>
  </section>

  {featuredPosts.length > 0 && (
    <section class="page reveal" style="padding-top: 0;">
      <div class="section-head">
        <h2 class="section-title">精选</h2>
      </div>
      <ul class="post-list">
        {featuredPosts.map((post) => <PostCard post={post} />)}
      </ul>
    </section>
  )}

  <section class="page reveal" style="padding-top: 0;">
    <div class="section-head">
      <h2 class="section-title">最新文章</h2>
      <a href="/blog/" class="section-more">
        查看全部 <span class="arrow">→</span>
      </a>
    </div>
    <ul class="post-list">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </ul>
  </section>

  <section class="page reveal" style="padding-top: 0;">
    <div class="section-head">
      <h2 class="section-title">精选项目</h2>
      <a href="/projects/" class="section-more">
        全部项目 <span class="arrow">→</span>
      </a>
    </div>
    <div class="project-grid">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
  </section>
</Base>

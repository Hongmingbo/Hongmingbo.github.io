/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  /* 暗色模式采用深靛蓝分层；亮色模式保留 Fuwari 原有冷青体系 */
  --primary: oklch(0.70 0.14 var(--hue)) oklch(0.82 0.09 var(--hue))
  --page-bg: oklch(0.95 0.01 var(--hue)) #1F2540
  --card-bg: white #2B3452

  --btn-content: oklch(0.55 0.12 var(--hue)) oklch(0.89 0.06 var(--hue))

  --btn-regular-bg: oklch(0.95 0.025 var(--hue)) #30395B
  --btn-regular-bg-hover: oklch(0.9 0.05 var(--hue)) #3A466B
  --btn-regular-bg-active: oklch(0.85 0.08 var(--hue)) #46537C

  --btn-plain-bg-hover: oklch(0.95 0.025 var(--hue)) #30395B
  --btn-plain-bg-active: oklch(0.98 0.01 var(--hue)) #26304D

  --btn-card-bg-hover: oklch(0.98 0.005 var(--hue)) #30395B
  --btn-card-bg-active: oklch(0.9 0.03 var(--hue)) #3A466B

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.25 0.02 var(--hue)) oklch(0.97 0.012 var(--hue))

  --title-active: oklch(0.6 0.1 var(--hue)) oklch(0.72 0.11 var(--hue))

  --line-divider: black(0.08) rgba(225,231,255,0.14)

  --line-color: black(0.1) rgba(225,231,255,0.18)
  --meta-divider: black(0.2) rgba(225,231,255,0.28)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.90 0.05 var(--hue)) #3B4770
  --codeblock-selection: oklch(0.40 0.08 var(--hue)) #46537C
  --codeblock-bg: oklch(0.17 0.015 var(--hue)) #151A30
  --codeblock-topbar-bg: oklch(0.3 0.02 var(--hue)) #12172A

  --license-block-bg: black(0.03) #151A30

  --link-underline: oklch(0.93 0.04 var(--hue)) #3B4770
  --link-hover: oklch(0.95 0.025 var(--hue)) #3A466B
  --link-active: oklch(0.90 0.05 var(--hue)) #46537C

  --float-panel-bg: white #30395B

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.7 0.14 180) oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: oklch(0.89 0.050 var(--hue)) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.926 0.015 var(--hue)) oklch(0.22 0.02 var(--hue))
  --toc-btn-active: oklch(0.90 0.015 var(--hue)) oklch(0.25 0.02 var(--hue))
  --toc-width: 13rem
  --toc-item-active: oklch(0.70 0.13 var(--hue)) oklch(0.35 0.07 var(--hue))
})

/* 默认继承色：修复 currentColor 在暗色模式下回退黑色 */
:root.dark
  color #F5F7FF

/* ---------------- 暖橘色调（访客可切换） ----------------
   默认冷青由 --hue(200) 驱动。暖橘模式不只换 hue：
   把所有中性底（页面/卡片/按钮/正文）调暖，才是一套独立样式，
   否则只会像"只换了个强调色"，和冷调中性色打架。 */
html[data-mood="warm"]
  --page-bg: oklch(0.962 0.022 62)
  --card-bg: oklch(0.995 0.007 62)
  --btn-regular-bg: oklch(0.955 0.03 60)
  --btn-regular-bg-hover: oklch(0.925 0.045 60)
  --btn-regular-bg-active: oklch(0.895 0.06 60)
  --btn-plain-bg-hover: oklch(0.955 0.03 60)
  --btn-plain-bg-active: oklch(0.972 0.02 60)
  --btn-card-bg-hover: oklch(0.975 0.018 60)
  --btn-card-bg-active: oklch(0.925 0.04 60)
  --deep-text: oklch(0.28 0.03 55)
  --line-divider: black(0.09)
  --line-color: black(0.11)
  --selection-bg: oklch(0.90 0.06 60)
  --link-underline: oklch(0.93 0.05 60)
  --link-hover: oklch(0.95 0.03 60)
  --link-active: oklch(0.90 0.06 60)

html[data-mood="warm"].dark
  --page-bg: oklch(0.265 0.02 50)
  --card-bg: oklch(0.315 0.024 50)
  --btn-regular-bg: oklch(0.345 0.03 52)
  --btn-regular-bg-hover: oklch(0.385 0.036 52)
  --btn-regular-bg-active: oklch(0.425 0.042 52)
  --btn-plain-bg-hover: oklch(0.345 0.03 52)
  --btn-plain-bg-active: oklch(0.30 0.024 50)
  --btn-card-bg-hover: oklch(0.36 0.028 52)
  --btn-card-bg-active: oklch(0.42 0.038 52)
  --deep-text: oklch(0.96 0.012 60)
  --line-divider: rgba(255, 236, 214, 0.16)
  --line-color: rgba(255, 236, 214, 0.20)
  --selection-bg: oklch(0.42 0.06 55)
  --link-underline: oklch(0.38 0.05 55)
  --link-hover: oklch(0.35 0.04 55)
  --link-active: oklch(0.42 0.06 55)

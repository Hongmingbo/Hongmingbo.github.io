---
interface Props {
	class: string;
}
const className = Astro.props.class;
---
<div data-pagefind-body class={`prose dark:prose-invert prose-base !max-w-none custom-md ${className}`}>
    <!--<div class="prose dark:prose-invert max-w-none custom-md">-->
    <!--<div class="max-w-none custom-md">-->
    <slot/>
</div>

<script>
const root = document.documentElement;

if (!root.hasAttribute("data-copy-handler-bound")) {
    root.setAttribute("data-copy-handler-bound", "true");

    document.addEventListener("click", async (event: MouseEvent) => {
        const origin = event.target;
        if (!(origin instanceof Element)) return;

        const button = origin.closest<HTMLButtonElement>(".copy-btn");
        if (!button) return;

        const pre = button.closest("pre");
        const codeElement = pre?.querySelector("code");
        const code = Array.from(codeElement?.querySelectorAll(".code:not(summary *)") ?? [])
            .map((line) => line.textContent ?? "")
            .map((line) => line === "\n" ? "" : line)
            .join("\n");

        const timeoutId = button.getAttribute("data-timeout-id");
        if (timeoutId) window.clearTimeout(Number(timeoutId));

        const idleLabel = button.dataset.copyIdleLabel ?? button.getAttribute("aria-label") ?? "复制代码";
        button.dataset.copyIdleLabel = idleLabel;
        button.classList.remove("success", "error");

        try {
            if (!code || !navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
            await navigator.clipboard.writeText(code);
            button.classList.add("success");
            button.setAttribute("aria-label", "已复制");
        } catch {
            button.classList.add("error");
            button.setAttribute("aria-label", "复制失败");
        }

        const newTimeoutId = window.setTimeout(() => {
            button.classList.remove("success", "error");
            button.setAttribute("aria-label", idleLabel);
            button.removeAttribute("data-timeout-id");
        }, 1800);

        button.setAttribute("data-timeout-id", newTimeoutId.toString());
    });
}
</script>

---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getFeaturedPosts } from "@utils/featured-posts";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const featuredPosts = getFeaturedPosts(posts);
const [lead, ...supporting] = featuredPosts;
---

{featuredPosts.length > 0 && (
	<section class="featured-posts" aria-labelledby="featured-posts-title">
		<div class="featured-posts__heading">
			<div>
				<p class="featured-posts__eyebrow">CURATED SIGNAL</p>
				<h2 id="featured-posts-title">精选文章</h2>
			</div>
			<a class="featured-posts__all" href="/archive/">
				<span>浏览全部</span>
				<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
			</a>
		</div>

		<div class="featured-posts__grid">
			{lead && (
				<a class="featured-post featured-post--lead" href={getPostUrlBySlug(lead.slug)}>
					{lead.data.image && (
						<div class="featured-post__cover">
							<ImageWrapper src={lead.data.image} alt="" class="h-full w-full" />
						</div>
					)}
					<div class="featured-post__body">
						<div class="featured-post__meta">
							<span>{lead.data.category || "未分类"}</span>
							<time datetime={lead.data.published.toISOString()}>{formatDateToYYYYMMDD(lead.data.published)}</time>
						</div>
						<h3>{lead.data.title}</h3>
						<p>{lead.data.description}</p>
						<span class="featured-post__enter">打开文章 <Icon name="fa6-solid:arrow-up-right-from-square" aria-hidden="true" /></span>
					</div>
				</a>
			)}

			{supporting.length > 0 && (
				<div class="featured-posts__rail">
					{supporting.map((post) => (
						<a class="featured-post featured-post--supporting" href={getPostUrlBySlug(post.slug)}>
							<div class="featured-post__supporting-topline">
								<span>{post.data.category || "未分类"}</span>
								<time datetime={post.data.published.toISOString()}>{formatDateToYYYYMMDD(post.data.published)}</time>
							</div>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
							<Icon class="featured-post__supporting-arrow" name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
						</a>
					))}
				</div>
			)}
		</div>
	</section>
)}

<style>
	.featured-posts {
		margin-bottom: 1rem;
		padding: 1rem;
		border: 1px solid color-mix(in oklch, var(--primary) 18%, var(--card-border, #dce5e5));
		border-radius: var(--radius-large);
		background: color-mix(in oklch, var(--card-bg, #fff) 72%, transparent);
		box-shadow: 0 18px 45px -32px rgb(15 23 42 / 0.5);
	}
	.featured-posts__heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 0.8rem;
	}
	.featured-posts__eyebrow {
		margin: 0 0 0.18rem;
		color: var(--primary);
		font-family: var(--font-mono, monospace);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
	}
	.featured-posts h2 { margin: 0; font-size: 1.15rem; line-height: 1.2; }
	.featured-posts__all {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--primary);
		font-size: 0.72rem;
		white-space: nowrap;
	}
	.featured-posts__all svg,
	.featured-post__enter svg,
	.featured-post__supporting-arrow {
		transition: transform 180ms var(--ds-ease-out, cubic-bezier(0.16, 1, 0.3, 1));
	}
	.featured-posts__all:hover svg { transform: translateX(3px); }
	.featured-posts__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.9fr);
		gap: 0.75rem;
	}
	.featured-post {
		position: relative;
		display: flex;
		min-width: 0;
		border: 1px solid color-mix(in oklch, var(--card-border, #dce5e5) 82%, transparent);
		border-radius: calc(var(--radius-large) - 0.2rem);
		background: color-mix(in oklch, var(--card-bg, #fff) 84%, transparent);
		color: inherit;
		overflow: hidden;
		transition: transform 220ms var(--ds-ease-out, cubic-bezier(0.16, 1, 0.3, 1)), border-color 220ms ease, box-shadow 220ms ease;
	}
	.featured-post:hover {
		transform: translateY(-2px);
		border-color: color-mix(in oklch, var(--primary) 42%, var(--card-border, #dce5e5));
		box-shadow: 0 18px 30px -25px color-mix(in oklch, var(--primary) 55%, transparent);
	}
	.featured-post--lead { min-height: 14rem; }
	.featured-post__cover {
		position: absolute;
		inset: 0 0 0 auto;
		width: 42%;
		mask-image: linear-gradient(to right, transparent 0%, black 42%);
	}
	.featured-post__cover::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, var(--card-bg, #fff) 0%, transparent 65%);
		content: "";
	}
	.featured-post__body {
		position: relative;
		display: flex;
		width: 68%;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.05rem 1.1rem;
	}
	.featured-post__meta,
	.featured-post__supporting-topline {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-50, rgb(100 116 139));
		font-family: var(--font-mono, monospace);
		font-size: 0.61rem;
		letter-spacing: 0.04em;
	}
	.featured-post__meta span,
	.featured-post__supporting-topline span { color: var(--primary); }
	.featured-post h3 {
		margin: 0.65rem 0 0;
		font-size: clamp(1.1rem, 1.6vw, 1.55rem);
		line-height: 1.3;
	}
	.featured-post p {
		display: -webkit-box;
		margin: 0.55rem 0 0;
		overflow: hidden;
		color: var(--text-70, rgb(71 85 105));
		font-size: 0.76rem;
		line-height: 1.65;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}
	:global(.dark) .featured-post p { color: rgb(203 213 225); }
	:global(.dark) .featured-post__meta,
	:global(.dark) .featured-post__supporting-topline { color: rgb(148 163 184); }
	.featured-post__enter {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-top: auto;
		padding-top: 0.7rem;
		color: var(--primary);
		font-size: 0.7rem;
	}
	.featured-post:hover .featured-post__enter svg { transform: translate(2px, -2px); }
	.featured-posts__rail { display: grid; gap: 0.75rem; }
	.featured-post--supporting { flex-direction: column; padding: 0.95rem 1.05rem; }
	.featured-post--supporting h3 { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.45; }
	.featured-post--supporting p { margin-top: 0.3rem; font-size: 0.7rem; -webkit-line-clamp: 2; }
	.featured-post__supporting-arrow { position: absolute; right: 0.85rem; bottom: 0.8rem; color: var(--primary); font-size: 1.05rem; opacity: 0; transform: translateX(-4px); }
	.featured-post--supporting:hover .featured-post__supporting-arrow { opacity: 1; transform: translateX(0); }
	:global(.dark) .featured-posts { background: color-mix(in oklch, var(--card-bg, #172033) 72%, transparent); }
	:global(.dark) .featured-post { background: color-mix(in oklch, var(--card-bg, #172033) 82%, transparent); }
	:global(.dark) .featured-post__cover::after { background: linear-gradient(90deg, var(--card-bg, #172033) 0%, transparent 65%); }
	@media (max-width: 900px) {
		.featured-posts__grid { grid-template-columns: 1fr; }
		.featured-posts__rail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 560px) {
		.featured-posts { padding: 0.8rem; }
		.featured-posts__heading { align-items: start; }
		.featured-posts__rail { grid-template-columns: 1fr; }
		.featured-post--lead { min-height: 15rem; }
		.featured-post__cover { width: 52%; }
		.featured-post__body { width: 82%; padding: 0.95rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.featured-post,
		.featured-posts__all svg,
		.featured-post__enter svg,
		.featured-post__supporting-arrow { transition: none; }
		.featured-post:hover { transform: none; }
	}
</style>
---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  wide?: boolean;
}

const {
  title,
  description = '技术、设计与自动化。记录我在 AI Agent、前端工程、知识管理与自托管基础设施方面的实践与思考。',
  ogImage,
  wide = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === '首页' ? 'Hmingbo' : `${title} · Hmingbo`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Hmingbo RSS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand"><span class="bracket">[</span>hmingbo<span class="bracket">]</span></a>
        <nav class="nav">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined} class={Astro.url.pathname === '/' ? 'active' : ''}>首页</a>
          <a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined} class={Astro.url.pathname.startsWith('/blog') ? 'active' : ''}>文章</a>
          <a href="/projects/" aria-current={Astro.url.pathname.startsWith('/projects') ? 'page' : undefined} class={Astro.url.pathname.startsWith('/projects') ? 'active' : ''}>项目</a>
          <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined} class={Astro.url.pathname.startsWith('/about') ? 'active' : ''}>关于</a>
        </nav>
      </div>
    </header>

    <main class:list={[wide ? '' : 'container']}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div>
          © {new Date().getFullYear()} Hmingbo
          <span class="sep">·</span>
          <a href="/rss.xml">RSS</a>
          <span class="sep">·</span>
          <a href="https://github.com/Hongmingbo" target="_blank" rel="noreferrer">GitHub</a>
          <span class="sep">·</span>
          <a href="mailto:hongmingbo2011@gmail.com">邮件</a>
        </div>
        <div style="margin-top: 0.5rem; font-size: 0.75rem;">
          Built with <a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a> · Deployed on GitHub Pages
        </div>
      </div>
    </footer>

    <button class="back-top" id="backTop" aria-label="返回顶部">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 12V3M8 3L3 8M8 3L13 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <script is:inline>
      // 渐入动效
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -20px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // 返回顶部
      const backTop = document.getElementById('backTop');
      window.addEventListener('scroll', () => {
        backTop.classList.toggle('is-visible', window.scrollY > 400);
      }, { passive: true });
      backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
  </body>
</html>
